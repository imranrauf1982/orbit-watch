# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored — never commit real credentials.

# --- Supabase --------------------------------------------------------------
# Project URL and anon/publishable key, from Supabase → Project Settings → API.
# The anon key is safe to expose in the browser AS LONG AS Row Level Security
# (RLS) policies are enabled on every table it can reach.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service role key — server-side ONLY (src/lib/supabase-admin.ts). This key
# bypasses Row Level Security. NEVER prefix it with NEXT_PUBLIC_, never import
# supabase-admin.ts into a "use client" component, and never commit the real
# value anywhere.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Analytics (optional) ---------------------------------------------------
# Google Analytics 4 measurement ID. Leave unset to disable analytics entirely
# (e.g. for local dev or a fork) — GoogleAnalytics.tsx renders nothing without it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
